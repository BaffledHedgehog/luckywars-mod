      "output": "minecraft:main"
    },
    {
      "vertex_shader": "lbc:post/nuclear_heat_many",
      "fragment_shader": "lbc:post/nuclear_heat_many",
      "inputs": [
        {
          "sampler_name": "NuclearData",
          "target": "effect_state"
