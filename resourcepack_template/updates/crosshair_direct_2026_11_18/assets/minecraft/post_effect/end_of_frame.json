{
  "targets": {
    "bloomh": {},
    "bloomv": {},
    "black_hole_scene": {},
    "black_hole_trace": {},
    "nuclear_volume": {},
    "nuclear_scene": {},
    "effect_state": {
      "width": 171,
      "height": 68
    },
    "effect_history": {
      "width": 171,
      "height": 68,
      "persistent": true,
      "clear_color": 0
    },
    "time_frame": {
      "width": 3840,
      "height": 2160,
      "persistent": true,
      "clear_color": 0
    },
    "time_gate": {
      "width": 1,
      "height": 1
    },
    "time_previous": {
      "width": 1,
      "height": 1,
      "persistent": true,
      "clear_color": 0
    }
  },
  "passes": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "lbc:post/time_gate",
      "inputs": [
        {
          "sampler_name": "Scene",
          "target": "minecraft:main"
        },
        {
          "sampler_name": "History",
          "target": "time_previous"
        }
      ],
      "output": "time_gate"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/blit",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "time_gate"
        }
      ],
      "output": "time_previous",
      "uniforms": {
        "BlitConfig": [
          {
            "name": "ColorModulate",
            "type": "vec4",
            "value": [
              1,
              1,
              1,
              1
            ]
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "lbc:post/effect_state",
      "inputs": [
        {
          "sampler_name": "Current",
          "target": "minecraft:main"
        },
        {
          "sampler_name": "History",
          "target": "effect_history"
        }
      ],
      "output": "effect_state"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/blit",
      "inputs": [
        {
          "sampler_name": "In",
          "target": "effect_state"
        }
      ],
      "output": "effect_history",
      "uniforms": {
        "BlitConfig": [
          {
            "name": "ColorModulate",
            "type": "vec4",
            "value": [
              1.0,
              1.0,
              1.0,
              1.0
            ]
          }
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
