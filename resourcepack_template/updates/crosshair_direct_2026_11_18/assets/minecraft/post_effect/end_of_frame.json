          "sampler_name": "NuclearData",
          "target": "effect_state"
        },
        {
          "sampler_name": "Scene",
          "target": "black_hole_scene"
        },
        {
          "sampler_name": "SceneDepth",
          "target": "minecraft:main",
          "use_depth_buffer": true
        },
        {
          "sampler_name": "Volume",
          "target": "nuclear_volume"
        }
