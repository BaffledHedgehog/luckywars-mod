        "BlitConfig": [
          {
            "name": "ColorModulate",
            "type": "vec4",
            "value": [
              1.0,
              1.0,
              1.0,
              1.0
            ]
          },
          {
            "name": "BlurDir",
            "type": "vec2",
            "value": [
              1.0,
              0.0
            ]
          }
        ]
      }
