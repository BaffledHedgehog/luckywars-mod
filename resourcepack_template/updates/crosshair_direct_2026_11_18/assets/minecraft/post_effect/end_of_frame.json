        {
          "sampler_name": "Scene",
          "target": "nuclear_scene",
          "bilinear": true
        },
        {
          "sampler_name": "SceneDepth",
          "target": "minecraft:main",
          "use_depth_buffer": true
        }
      ],
      "output": "black_hole_trace"
