# Local working notes (existing versioned reference documents stay tracked).
/agent_notes/

# Local Gradle state, generated artifacts and isolated verification servers.
/.gradle/
/build/
/bin/
/logs/

# Personal IDE configuration.
/.vscode/settings.json
/.idea/

# Extracted dependency sources and Python bytecode.
/net/
__pycache__/
*.py[cod]

# JVM diagnostics and disposable editor/process files.
/replay_pid*.log
/hs_err_pid*.log
/javac.*.args
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# Large JVM recordings and local test runtime state.
/*.hprof
/*.jfr
/.serena/cache/

# Private TikTok account credentials; media is kept under the server world's data/luckywars/tiktok.
/config/skywars2/tiktok/

# Reproducible HD phone mesh and vocoder bank; regenerate with tools/build_tiktok_*.py.
/resourcepack_template/updates/tiktok_hd_2026_11_15/assets/skywars2/models/item/tiktok_screen.json
/resourcepack_template/updates/tiktok_hd_2026_11_15/assets/lbc/items/zaika_video.json
/resourcepack_template/updates/tiktok_hd_2026_11_15/assets/skywars2/sounds/tiktok/v2/*.ogg
# Reproducible full-resolution mesh; regenerate with build_feedback_2026_11_15_assets.py.
/resourcepack_template/updates/feedback_2026_11_15/assets/skywars2/models/item/tiktok_screen.json

# Optional media client uses its own Loom workspace.
/media-client/.gradle/
/media-client/build/
/media-client/run/
/media-client/logs/

# Reproducible stereo spectral bank; generated with build_tiktok_spectral_audio.py.
/resourcepack_template/updates/tiktok_audio_2026_11_16/assets/skywars2/sounds/tiktok/v3/*.ogg
