package me.skywars2.game;

import net.minecraft.core.registries.Registries;
import net.minecraft.resources.Identifier;
import net.minecraft.resources.ResourceKey;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.world.InteractionHand;
import net.minecraft.world.level.storage.loot.LootParams;
import net.minecraft.world.level.storage.loot.parameters.LootContextParamSets;
import net.minecraft.world.level.storage.loot.parameters.LootContextParams;

/**
 * UNREGISTERED DRAFT, deferred until the other item properties are complete.
 * Native self/counter owners are connected; custom bow/crossbow payloads and
 * multi-marker spell dispatch are still incomplete. No command execution.
 */
public final class LbcTmtSourceGroups implements LbcTmtActivation.SourceGroups {
    private final GameController game;

    public LbcTmtSourceGroups(GameController game) { this.game = game; }

    @Override public void swords(ServerPlayer player, InteractionHand hand) {
        // SelectedItem in items/swords is the main hand, even when an offhand
        // carrier caused USING_ITEM. Victim branches stay with accepted damage.
        game.items().classicMelee().tmtSelf(player);
        game.items().chargedSwords().tmtCharge(player);
    }

    @Override public void crossbowCharging(ServerPlayer player, InteractionHand hand) {
        var counter = game.items().mana().score(player, "crossbow_charge");
        counter.add(1);
        if (counter.get() != 1) return;
        boolean infinite = false;
        for (int slot = 0; slot <= 40; slot++)
            if (LbcFartus.data(player.getInventory().getItem(slot)).getIntOr("infinite_arrow", 0) == 1) {
                infinite = true;
                break;
            }
        if (!infinite) return;
        var table = game.server().reloadableRegistries().getLootTable(ResourceKey.create(
                Registries.LOOT_TABLE, Identifier.parse("lbc:imba/infinite_arrow")));
        var params = new LootParams.Builder(player.level())
                .withParameter(LootContextParams.ORIGIN, player.position())
                .withOptionalParameter(LootContextParams.THIS_ENTITY, player)
                .create(LootContextParamSets.COMMAND);
        for (var stack : table.getRandomItems(params)) {
            player.getInventory().add(stack);
            if (!stack.isEmpty()) {
                var dropped = player.drop(stack, false);
                if (dropped != null) {
                    dropped.setThrower(player);
                    game.items().markCurrentItemEpoch(dropped);
                }
            }
        }
        player.getInventory().setChanged();
    }

    @Override public void bows(ServerPlayer player, InteractionHand hand) {
        // This complement does not manufacture a second ordinary bow volley.
        // Real projectile/trinket notifications remain in their native shot hook.
        var mana = game.items().mana();
        mana.score(player, "bow").set(0);
        mana.score(player, "bow_charge").set(0);
        mana.score(player, "bow_charge_sub").set(0);
    }

    @Override public void crossbows(ServerPlayer player, InteractionHand hand) {
        game.items().mana().score(player, "crossbow_charge").set(0);
    }

    @Override public void spells(ServerPlayer player, InteractionHand hand) {
        // items/spells processes configured hands once from the selected main hand.
        game.items().wands().use(player, InteractionHand.MAIN_HAND);
    }
}
