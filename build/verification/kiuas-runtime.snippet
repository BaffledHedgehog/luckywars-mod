        private static void checkKiuasRuntime(GameController game) {
                require(game.playing(),"Kiuas runtime checks require a live match");
                var owner=game.server().getPlayerList().getPlayer(offlineUuid("TestAlpha"));
                require(owner!=null && game.allowDamage(owner),"Kiuas owner is an active participant");
                var state=new WandThirdPlayerState(owner,game.items().mana());
                var service=game.items().kiuas(); var mana=game.items().mana(); var level=game.maps().level();
                var blocks=new java.util.LinkedHashMap<net.minecraft.core.BlockPos,MapManager.BlockSnapshot>();
                var cows=new java.util.ArrayList<net.minecraft.world.entity.animal.cow.Cow>();
                var entities=new java.util.ArrayList<net.minecraft.world.entity.Entity>();
                var board=game.server().getScoreboard();
                var oldTeam=board.getPlayersTeam(owner.getScoreboardName());
                var team=board.getPlayerTeam("codex_kiuas"); boolean createdTeam=team==null;
                if(createdTeam) team=board.addPlayerTeam("codex_kiuas");
                int x=Math.floorDiv(owner.blockPosition().getX(),16)*16+8;
                int z=Math.floorDiv(owner.blockPosition().getZ(),16)*16+8;
                var center=new net.minecraft.core.BlockPos(x,260,z);
                try {
                        require(service.ready(),"Sun source pattern was prepared before testing");
                        service.stop(); owner.closeContainer(); owner.getInventory().clearContent(); owner.setNoGravity(true);
                        for(int cx=(x-27)>>4;cx<=(x+27)>>4;cx++)
                                for(int cz=(z-27)>>4;cz<=(z+27)>>4;cz++) level.getChunk(cx,cz);
                        owner.teleportTo(level,x+.5,260,z+.5,java.util.Set.of(),0,0,true);
                        for(int dx=-26;dx<=26;dx++) for(int dy=-16;dy<=16;dy++) for(int dz=-26;dz<=26;dz++) {
                                var pos=center.offset(dx,dy,dz); blocks.put(pos,game.maps().snapshot(pos));
                                if(!level.getBlockState(pos).isAir()) game.maps().restoreSnapshot(pos,MapManager.BlockSnapshot.air());
                        }
                        owner.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND,new ItemStack(LbcKiuas.KIUASKIVI));
                        var wood=center.offset(1,0,1); var stone=center.offset(-1,0,-1);
                        var water=center.offset(0,0,1);
                        level.setBlockAndUpdate(wood,net.minecraft.world.level.block.Blocks.OAK_PLANKS.defaultBlockState());
                        level.setBlockAndUpdate(stone,net.minecraft.world.level.block.Blocks.STONE.defaultBlockState());
                        level.setBlockAndUpdate(water,net.minecraft.world.level.block.Blocks.WATER.defaultBlockState());
                        mana.set(owner,999); service.tick();
                        require(mana.get(owner)==999 && service.queuedBlockCount()==0,"Kiuaskivi rejects activation below 1000");
                        mana.set(owner,1000); service.tick();
                        require(mana.get(owner)==0 && service.queuedBlockCount()==0 && level.getBlockState(wood).is(net.minecraft.world.level.block.Blocks.OAK_PLANKS),
                                        "Kiuaskivi exact activation has no unpaid maintenance pulse");
                        mana.set(owner,1100); service.tick();
                        require(mana.get(owner)==90 && owner.hasEffect(net.minecraft.world.effect.MobEffects.FIRE_RESISTANCE),
                                        "Kiuaskivi pays 1000 plus 10 on its first active tick");
                        mana.set(owner,10000);
                        for(int i=0;i<60 && service.queuedBlockCount()>0;i++) service.tick();
                        require(level.getBlockState(wood).is(net.minecraft.world.level.block.Blocks.FIRE)
                                        && level.getBlockState(water).is(net.minecraft.world.level.block.Blocks.FIRE)
                                        && level.getBlockState(stone).is(net.minecraft.world.level.block.Blocks.STONE),
                                        "Kiuaskivi keeps ordered air-then-fire fills including water, without burning untagged stone");
                        var changed=center.offset(1,1,0);
                        level.setBlockAndUpdate(changed,net.minecraft.world.level.block.Blocks.OAK_PLANKS.defaultBlockState());
                        service.tick();
                        require(level.getBlockState(changed).is(net.minecraft.world.level.block.Blocks.FIRE),"Kiuaskivi reacts to new eligible blocks through native dirty events");
                        service.stop(); mana.set(owner,2020);
                        owner.setItemInHand(net.minecraft.world.InteractionHand.OFF_HAND,new ItemStack(LbcKiuas.KIUASKIVI)); service.tick();
                        require(mana.get(owner)==0,"Two Kiuaskivi independently spend 1010 each");
                        service.stop(); mana.set(owner,10000); service.tick();
                        require(mana.get(owner)==7980,"Two Kiuaskivi start independent active branches with sufficient reserve");
                        service.tick(); require(mana.get(owner)==7960,"Two active Kiuaskivi charge 20 per tick");
                        service.stop(); owner.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND,ItemStack.EMPTY);
                        owner.setItemInHand(net.minecraft.world.InteractionHand.OFF_HAND,ItemStack.EMPTY);
                        for(var entry:blocks.entrySet()) game.maps().restoreSnapshot(entry.getKey(),entry.getValue());
                        owner.setItemInHand(net.minecraft.world.InteractionHand.OFF_HAND,new ItemStack(LbcKiuas.SUN));
                        var victim=indirectCow(level,cows,x+4.5,260,z+.5);
                        victim.getAttribute(net.minecraft.world.entity.ai.attributes.Attributes.MAX_HEALTH).setBaseValue(100); victim.setHealth(100); victim.setNoAi(true);
                        mana.set(owner,1600);
                        for(int i=0;i<4;i++) service.tick();
                        require(mana.get(owner)==1600,"Sun only processes its hand on the five-tick cadence");
                        service.tick();
                        require(mana.get(owner)==0 && victim.getHealth()==100,"One offhand Sun spends 1500+100 without aura damage");
                        owner.setItemInHand(net.minecraft.world.InteractionHand.OFF_HAND,ItemStack.EMPTY);
                        for(int i=0;i<100 && service.queuedBlockCount()>0;i++) service.tick();
                        require(service.queuedBlockCount()==0,"Paid Sun source pattern completes after removing its hand");
                        var template=game.server().getStructureTemplateManager().get(net.minecraft.resources.Identifier.parse("lbc:the_sun")).orElseThrow();
                        var nbt=template.save(new net.minecraft.nbt.CompoundTag());
                        var palette=new java.util.ArrayList<net.minecraft.world.level.block.state.BlockState>();
                        for(var tag:nbt.getListOrEmpty("palette")) palette.add(net.minecraft.nbt.NbtUtils.readBlockState(
                                        level.registryAccess().lookupOrThrow(net.minecraft.core.registries.Registries.BLOCK),(net.minecraft.nbt.CompoundTag)tag));
                        int checked=0;
                        for(var tag:nbt.getListOrEmpty("blocks")) {
                                var block=(net.minecraft.nbt.CompoundTag)tag; var pos=block.getListOrEmpty("pos");
                                var target=center.offset(pos.getIntOr(0,0)-13,pos.getIntOr(1,0)-13,pos.getIntOr(2,0)-13);
                                require(level.getBlockState(target).equals(palette.get(block.getIntOr("state",0))),"Sun keeps each exact source template cell, including explicit air"); checked++;
                        }
                        require(checked==6683,"Sun tests all 6683 native template records");
                        service.stop();
                        owner.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND,new ItemStack(LbcKiuas.SUN));
                        owner.setItemInHand(net.minecraft.world.InteractionHand.OFF_HAND,new ItemStack(LbcKiuas.SUN));
                        var ally=indirectCow(level,cows,x-4.5,260,z+.5);
                        var npc=indirectCow(level,cows,x+.5,260,z+4.5); npc.entityTags().add("magic_academy");
                        board.removePlayerFromTeam(owner.getScoreboardName()); board.addPlayerToTeam(owner.getScoreboardName(),team);
                        board.addPlayerToTeam(ally.getScoreboardName(),team);
                        victim.setHealth(100); victim.setInvulnerableTime(0);
                        var arrow=new net.minecraft.world.entity.projectile.arrow.Arrow(level,owner,new ItemStack(Items.ARROW),null);
                        arrow.setPos(x+20.5,262,z+.5); arrow.setNoGravity(true); require(level.addFreshEntity(arrow),"Sun projectile fixture enters loaded chunks"); entities.add(arrow);
                        var lava=arrow.blockPosition().immutable();
                        var near=new net.minecraft.world.entity.projectile.arrow.Arrow(level,owner,new ItemStack(Items.ARROW),null);
                        near.setPos(x+2.5,263,z+.5); near.setNoGravity(true); require(level.addFreshEntity(near),"Sun near projectile fixture spawns"); entities.add(near);
                        mana.set(owner,3200); for(int i=0;i<5;i++) service.tick();
                        require(mana.get(owner)==0 && victim.getHealth()==90 && victim.getKillCredit()==owner,
                                        "Two Sun independently pay 1600 each and native fire aura credits their actual owner (normal damage cooldown preserved)");
                        require(ally.getHealth()==ally.getMaxHealth() && npc.getHealth()==npc.getMaxHealth(),"Sun direct aura protects allies and service roles");
                        require(arrow.isRemoved() && level.getBlockState(lava).is(net.minecraft.world.level.block.Blocks.LAVA)
                                        && near.isAlive(),"Sun converts owned projectiles at 8..25 into lava while retaining nearby projectiles");
                        var environmental=level.damageSources().lava();
                        var exposed=indirectCow(level,cows,lava.getX()+.5,lava.getY(),lava.getZ()+.5);
                        game.items().indirectKills().environmentDamage(exposed,environmental);
                        require(exposed.getKillCredit()==owner,"Sun-created lava carries the arcanum holder as environmental kill credit");
                        service.stop();
                        for(var entry:blocks.entrySet()) game.maps().restoreSnapshot(entry.getKey(),entry.getValue());
                        owner.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND,new ItemStack(LbcKiuas.KIUASKIVI));
                        owner.setItemInHand(net.minecraft.world.InteractionHand.OFF_HAND,ItemStack.EMPTY);
                        mana.set(owner,10000); owner.entityTags().add("time_stopped"); service.tick();
                        require(mana.get(owner)==10000 && service.queuedBlockCount()==0,"Paused Kiuaskivi does not spend or queue transformations");
                        owner.entityTags().remove("time_stopped"); service.tick();
                        require(mana.get(owner)==8990,"Kiuaskivi resumes after the pause with its normal activation and upkeep");
                        SkyWars2.LOGGER.info("[check] PASS kiuas");
                } finally {
                        service.stop();
                        entities.forEach(net.minecraft.world.entity.Entity::discard);
                        for(var cow:cows) { board.removePlayerFromTeam(cow.getScoreboardName()); cow.discard(); }
                        board.removePlayerFromTeam(owner.getScoreboardName()); if(oldTeam!=null) board.addPlayerToTeam(owner.getScoreboardName(),oldTeam);
                        if(createdTeam) board.removePlayerTeam(team);
                        for(var entry:blocks.entrySet()) game.maps().restoreSnapshot(entry.getKey(),entry.getValue());
                        state.restore(game);
                }
        }

